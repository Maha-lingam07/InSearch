# Copy this file to .env and fill in your provider keys.
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=

# Generate a private 32-byte key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Google Cloud OAuth web client. Enable Gmail API and Google Sheets API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connect/google/callback

# Meta app configured for Instagram Login / Instagram API.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/connect/instagram/callback
